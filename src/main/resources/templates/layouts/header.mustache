<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="_csrf" content="{{csrfToken}}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/coffee-ui.css" rel="stylesheet">
</head>
<nav class="coffee-nav" aria-label="Main navigation">
    {{#loggedIn}}<a class="coffee-nav-brand" href="/account">{{username}}</a>{{/loggedIn}}
    {{^loggedIn}}<a class="coffee-nav-brand" href="/coffee">Coffee House</a>{{/loggedIn}}
    <div class="coffee-nav-links">
        <a href="/coffee">Home</a>
        <a href="/coffee/read">Coffee List</a>
        {{^loggedIn}}
        <a href="/membership/signup">SignUp</a>
        <a href="/login" class="coffee-action coffee-action--modify">Login</a>
        {{/loggedIn}}
        {{#loggedIn}}
        <a href="/account">My account</a>
        <a href="/basket">Basket</a>
        {{#isAdmin}}<a href="/members">Members</a>{{/isAdmin}}
        <form action="/logout" method="post">
            {{>layouts/csrf}}
            <button type="submit" class="coffee-action coffee-action--neutral">Logout</button>
        </form>
        {{/loggedIn}}
    </div>
    <form class="coffee-nav-search" action="/coffee/read" method="get" role="search">
        <input name="q" value="{{searchQuery}}" class="form-control" type="search"
               placeholder="Search coffee…" aria-label="Search coffee by name" maxlength="255">
        <button class="coffee-action coffee-action--modify" type="submit">Search</button>
    </form>
</nav>
