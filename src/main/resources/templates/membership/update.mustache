{{>layouts/header}}

<form class="container mt-5"
      action="/members/update/{{member.id}}"
      method="post">

    <h2>회원정보 수정</h2>

    <div class="mb-3">
        <label class="form-label">전자메일</label>
        <input type="email"
               class="form-control"
               name="email"
               value="{{member.email}}"
               required>
    </div>

    <div class="mb-3">
        <label class="form-label">새 비밀번호</label>
        <input type="password"
               class="form-control"
               name="password"
               required>
    </div>

    <button type="submit" class="btn btn-primary">수정 완료</button>
    <a href="/members/{{member.id}}" class="btn btn-secondary">취소</a>
</form>

{{>layouts/footer}}