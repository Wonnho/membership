{{>/layouts/header}}

<table class="table table-striped">
  <thead>
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Email</th>
      <th scope="col">Password</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <th scope="row">{{member.id}}</th>
      <td>{{member.email}}</td>
    </tr>
  </tbody>
</table>
 <a href="/members/update/{{member.id}}" class="btn btn-info">수정</a>
<a href="/members">MemberList</a>
<form action="/members/delete/{{member.id}}"
      method="post"
      class="d-inline">
    <button type="submit" class="btn btn-danger">삭제</button>
</form>
{{>/layouts/footer}}