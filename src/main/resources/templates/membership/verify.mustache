{{>layouts/header}}
<main class="container py-5">
    <section class="member-detail auth-card">
        <div class="member-detail-heading">
            <p class="text-muted mb-2">Email verification</p>
            <h1 class="h2">Halo!</h1>
            <p class="text-muted mb-0">Check your inbox and enter the six-digit code to verify your email.</p>
        </div>
        <form class="p-4" action="/membership/verify" method="post">
            {{>layouts/csrf}}
            {{#hasVerificationMessage}}<p class="alert alert-info" role="status">{{verificationMessage}}</p>{{/hasVerificationMessage}}
            {{#hasFormError}}<p class="alert alert-danger" role="alert">{{formError}}</p>{{/hasFormError}}
            <label for="verify-email" class="form-label">Signup email</label>
            <input id="verify-email" type="email" name="email" value="{{verificationEmail}}" class="form-control mb-3" autocomplete="email" required maxlength="254">
            <label for="verify-code" class="form-label">Verification code</label>
            <input id="verify-code" name="code" type="text" class="form-control mb-3" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" autocomplete="one-time-code" placeholder="6-digit code" required>
            <p class="form-text">The code expires in 10 minutes and works once. Check your spam folder too.</p>
            <div class="coffee-actions">
                <button type="submit" class="coffee-action coffee-action--modify">Verify email</button>
                <button type="submit" formaction="/membership/verify/resend" formnovalidate class="coffee-action coffee-action--neutral">Resend code</button>
            </div>
            <p class="form-text mt-3">Wait 60 seconds between resends. Up to 5 codes per hour.</p>
            <a href="/login">Back to Login</a>
        </form>
    </section>
</main>
{{>layouts/footer}}
