{{>layouts/header}}
<main class="container py-5">
    <section class="member-detail auth-card">
        <div class="member-detail-heading">
            <p class="text-muted mb-2">Membership</p>
            <h1 class="h2">Create your account</h1>
            <p class="text-muted mb-0">Sign up with your email and password. {{#verificationEnabled}}We will email you a code to verify the address before your first login.{{/verificationEnabled}}{{^verificationEnabled}}After signup, log in with your chosen password.{{/verificationEnabled}}</p>
        </div>
        <form class="p-4" action="/join" method="post">
            {{>layouts/csrf}}
            {{#formError}}<div class="alert alert-danger" role="alert">{{formError}}</div>{{/formError}}
            <label for="signup-email" class="form-label">Email</label>
            <input id="signup-email" type="email" class="form-control mb-3" name="email"
                   value="{{email}}" autocomplete="email" required maxlength="254">
            <label for="signup-password" class="form-label">Password</label>
            <input id="signup-password" type="password" class="form-control" name="password"
                   autocomplete="new-password" minlength="8" required aria-describedby="password-help">
            <p id="password-help" class="form-text mb-4">At least 8 characters; no more than 72 UTF-8 bytes.</p>
            <button type="submit" class="coffee-action coffee-action--modify">SignUp</button>
            <a href="/login" class="ms-3">Already registered? Login</a>
            {{#verificationEnabled}}<p class="mt-3 mb-0"><a href="/membership/verify">Already signed up? Verify your email or resend a code</a></p>{{/verificationEnabled}}
        </form>
    </section>
</main>
{{>layouts/footer}}
