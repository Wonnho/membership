<div class="mb-4">
    <label class="form-label" for="image-value">Image</label>
    <input id="image-value" name="image" type="hidden" value="{{imageValue}}">
    <div><img id="image-preview" alt="Selected coffee image" hidden
              style="max-width: 240px; max-height: 200px; object-fit: contain;"></div>
    <button id="open-upload" type="button" class="btn btn-outline-primary mt-2">Upload File</button>
    <p id="image-status" class="text-muted mt-2" role="status">Upload a JPG or PNG image.</p>
</div>
<dialog id="upload-dialog" aria-labelledby="upload-title"
        style="border: 1px solid #ccc; border-radius: 8px; width: min(500px, 90vw);">
    <h2 id="upload-title" class="h4">Upload File</h2>
    <label for="upload-file" class="form-label">Choose an image (JPG or PNG, up to 5 MB)</label>
    <input id="upload-file" type="file" accept="image/jpeg,image/png" class="form-control mb-3">
    <p id="upload-error" class="text-danger" role="alert"></p>
    <button id="upload-button" type="button" class="btn btn-primary">Upload</button>
    <button id="close-upload" type="button" class="btn btn-secondary">Close</button>
</dialog>
<script src="/js/coffee-upload.js" defer></script>
